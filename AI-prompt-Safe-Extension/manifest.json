{
  "manifest_version": 3,
  "name": "AI Safe Prompt",
  "version": "1.0",
  "description": "Mask sensitive data before sending prompts",
  "key": "",

  "permissions": ["storage", "activeTab", "scripting", "identity"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "oauth2": {
    "client_id": "766985052649-07uq48gd6mrjroqmbpk9ing77asr3j3j.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "host_permissions": [
    "<all_urls>",
    "https://ai-safe-prompt.onrender.com/*",
    "https://ai-safe-prompt-python-backend.onrender.com/*"
  ],
  

  
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    } 
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
